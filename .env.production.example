# Production deployment template. Copy to .env.production on the backend host.
# This tracked file contains placeholders only. Never commit the populated file.

RABBITMQ_DEFAULT_USER=replace-with-production-user
RABBITMQ_DEFAULT_PASS=replace-with-production-secret
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

REDIS_PORT=6379

OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
JAEGER_UI_PORT=16686

# Core.Api is host-loopback only. A secure tunnel/private network terminates outside this compose stack.
CORE_API_PORT=8080

# Immutable release identity used in image tags. The deployment script overrides this with the current Git SHA.
AIOFFICE_RELEASE_TAG=git-sha

# Runtime secret value consumed only inside Core.Api through secretref://env/AIOFFICE_DB_CONNECTION.
# Populate this on the server from the approved secret source; this placeholder is intentionally not a connection string.
AIOFFICE_DB_CONNECTION=replace-with-runtime-secret-connection-string
