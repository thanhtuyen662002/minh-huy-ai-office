# Production deployment template. Copy to .env.production on the backend host.
# This tracked file contains placeholders only. Never commit the populated file.

RABBITMQ_DEFAULT_USER=replace-with-production-user
RABBITMQ_DEFAULT_PASS=replace-with-production-secret
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

REDIS_PORT=6379

OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
JAEGER_UI_PORT=16686

# Core.Api is host-loopback only. A secure tunnel/private network terminates outside this compose stack.
CORE_API_PORT=8080

# FE is served by the standalone container and publishes only on host loopback.
AIOFFICE_WEB_PORT=3000

# OIDC issuer and API audience. These are configuration values, not browser authority.
AIOFFICE_AUTHORITY=https://identity.example.invalid/realms/aioffice
AIOFFICE_AUDIENCE=minh-huy-ai-office

# Self-hosted identity is deployed separately with compose.identity.yaml.
# Set false (or omit) to retain an external approved OIDC provider.
AIOFFICE_KEYCLOAK_ENABLED=true
AIOFFICE_KEYCLOAK_HOSTNAME=https://identity.example.invalid
AIOFFICE_KEYCLOAK_PORT=8081
# Private SQL DNS name only, never a URL/connection string. Database is fixed to AIOffice_Identity.
# SQL must present a trusted TLS certificate for this name (encrypt=true, trustServerCertificate=false).
AIOFFICE_KEYCLOAK_DB_HOST=replace-with-private-sql-hostname
AIOFFICE_KEYCLOAK_DB_PORT=1433
# true only for a SQL Server with a self-signed certificate: traffic stays encrypted but the
# certificate is not verified. Prefer a trusted certificate and keep false.
AIOFFICE_KEYCLOAK_DB_TRUST_SERVER_CERTIFICATE=false
# Absolute paths to protected, nonempty files populated by the approved secret manager.
# Compose mounts these as /run/secrets/*; Keycloak's entrypoint reads them at runtime.
# Username/password files contain a single value, not secretref:// strings or connection strings.
AIOFFICE_KEYCLOAK_DB_USERNAME_FILE=replace-with-private-db-username-file
AIOFFICE_KEYCLOAK_DB_PASSWORD_FILE=replace-with-private-db-password-file
AIOFFICE_KEYCLOAK_ADMIN_USERNAME_FILE=replace-with-private-bootstrap-admin-username-file
AIOFFICE_KEYCLOAK_ADMIN_PASSWORD_FILE=replace-with-private-bootstrap-admin-password-file

# Optional member provisioning; both identity import and Core use the same protected file.
# No secret value belongs in this env file or realm JSON. Default is disabled.
AIOFFICE_KEYCLOAK_PROVISIONING_ENABLED=false
AIOFFICE_KEYCLOAK_PROVISIONING_CLIENT_SECRET_FILE=

# Opt in only after the approved HTTPS provider, API and TLS Redis are ready.
# Browser issuer is the same AIOFFICE_AUTHORITY used by Core; password grant stays disabled.
# Register exact PUBLIC_ORIGIN/api/local/session/oidc/callback, Code/S256 and RS256.
AIOFFICE_BROWSER_OIDC_ENABLED=false
AIOFFICE_BROWSER_OIDC_PUBLIC_ORIGIN=https://office.example.invalid
AIOFFICE_BROWSER_OIDC_ISSUER=https://identity.example.invalid/realms/aioffice
AIOFFICE_BROWSER_OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.invalid/realms/aioffice/protocol/openid-connect/auth
AIOFFICE_BROWSER_OIDC_TOKEN_ENDPOINT=https://identity.example.invalid/realms/aioffice/protocol/openid-connect/token
AIOFFICE_BROWSER_OIDC_JWKS_URI=https://identity.example.invalid/realms/aioffice/protocol/openid-connect/certs
AIOFFICE_BROWSER_OIDC_CLIENT_ID=aioffice-browser
# Empty for a public PKCE client; confidential client secret comes from the approved secret source.
AIOFFICE_BROWSER_OIDC_CLIENT_SECRET=
# A stable cryptographically random32-byte base64url key, stored privately on the operator host.
AIOFFICE_BROWSER_OIDC_TRANSACTION_KEY=
# HTTPS Core origin and private rediss:// endpoint; plaintext Compose Redis is not browser session authority.
AIOFFICE_BROWSER_CORE_API_ORIGIN=
AIOFFICE_BROWSER_SESSION_REDIS_URL=
# Initial UI company context only, never a grant or identity.
AIOFFICE_COMPANY_ID=22222222-2222-2222-2222-222222222222
AIOFFICE_COMPANY_NAME=Minh Huy

# Immutable release identity used in image tags. The deployment script overrides this with the current Git SHA.
AIOFFICE_RELEASE_TAG=git-sha

# Runtime secret value consumed only inside Core.Api through secretref://env/AIOFFICE_DB_CONNECTION.
# Populate this on the server from the approved secret source; this placeholder is intentionally not a connection string.
AIOFFICE_DB_CONNECTION=replace-with-runtime-secret-connection-string

# The first read-only pilot data source uses this environment-backed secret reference.
# Add other data-source secret references through the approved secret provider before use.
PILOT_ERP_CONNECTION=replace-with-pilot-erp-readonly-connection-string


# Optional model-backed pilot path. The direct API is PRIMARY for normal testing/use.
# PRIMARY requires BASE_URL + MODEL + AUTHORIZATION together. BACKUP is optional and is called
# only after retryable primary failures. Authorization values are complete HTTP Authorization
# header values and must come from an approved runtime secret source.
AIOFFICE_AI_PRIMARY_BASE_URL=
AIOFFICE_AI_PRIMARY_MODEL=
AIOFFICE_AI_PRIMARY_AUTHORIZATION=
AIOFFICE_AI_PRIMARY_PROVIDER_ID=openai-direct

AIOFFICE_AI_BACKUP_BASE_URL=
AIOFFICE_AI_BACKUP_MODEL=
AIOFFICE_AI_BACKUP_AUTHORIZATION=
AIOFFICE_AI_BACKUP_PROVIDER_ID=external-backup

# Backward-compatible single-provider aliases. Leave empty for new deployments.
AIOFFICE_AI_BASE_URL=
AIOFFICE_AI_MODEL=
AIOFFICE_AI_AUTHORIZATION=
AIOFFICE_AI_PROVIDER_ID=openai-compatible
# Required for protected customer ERP credentials. Base64 of 32 random bytes;
# provision from the approved secret source and retain with encrypted backups.
AIOFFICE_SECRET_ENCRYPTION_KEY=
