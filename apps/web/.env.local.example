# Local browser UI only. Copy this file to apps/web/.env.local.
# Do not commit populated secret values.

AIOFFICE_LOCAL_UI_ENABLED=true
AIOFFICE_LOCAL_CORE_API_URL=http://127.0.0.1:8080
AIOFFICE_LOCAL_OIDC_TOKEN_URL=http://127.0.0.1:18080/realms/aioffice-local/protocol/openid-connect/token
AIOFFICE_LOCAL_OIDC_CLIENT_ID=aioffice-local-cli
AIOFFICE_LOCAL_COMPANY_ID=22222222-2222-2222-2222-222222222222
AIOFFICE_LOCAL_COMPANY_NAME=Minh Huy

# Set true only when the local UI itself is served over HTTPS.
AIOFFICE_LOCAL_UI_COOKIE_SECURE=false
