# Local development only. Copy to .env and change values as needed.
# .env is ignored by Git and must never contain production secrets.

RABBITMQ_DEFAULT_USER=ai-office-dev
RABBITMQ_DEFAULT_PASS=local-dev-only-change-me
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

REDIS_PORT=6379

# SQL Server is intentionally not exposed or provisioned by this compose file.
# The platform DB may be local or remote and will later be resolved through
# environment/secret references + Data Source Registry.
AIOFFICE_SQLSERVER_HOST=
AIOFFICE_SQLSERVER_DATABASE=AIOffice_Dev
AIOFFICE_SQLSERVER_CREDENTIAL_REF=
