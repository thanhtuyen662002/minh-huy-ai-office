# Local development only. Copy to .env and replace placeholder values as needed.
# .env is ignored by Git. This tracked example contains references/placeholders only.

RABBITMQ_DEFAULT_USER=ai-office-dev
RABBITMQ_DEFAULT_PASS=replace-with-local-dev-password
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

REDIS_PORT=6379

# Platform configuration stores an opaque reference, never the SQL credential itself.
# Set AIOFFICE_DB_CONNECTION only in the process environment or an approved secret store.
AIOffice__PlatformDatabase__ConnectionSecretRef=secretref://env/AIOFFICE_DB_CONNECTION

# Optional non-secret routing metadata for local tooling.
AIOFFICE_SQLSERVER_HOST=
AIOFFICE_SQLSERVER_DATABASE=AIOffice_Dev
